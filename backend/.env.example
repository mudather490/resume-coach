OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=embeddinggemma:latest
OLLAMA_CHAT_MODEL=llama3.2:3b
# Request budget (seconds). Raise on slow CPU-only machines; lower
# OLLAMA_NUM_PREDICT for faster, shorter answers.
OLLAMA_TIMEOUT=1200
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
# Local state directory (active resume JSON). Existing installs keep using
# ./chroma_db so an already-uploaded resume is preserved.
DATA_DIR=./chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
BACKEND_PORT=8000
# Vercel Functions cap request bodies at 4.5 MB (use 4 there).
MAX_UPLOAD_MB=10
REVIEW_CONTEXT_CHARS=24000

# --- LLM providers ---
# Chat provider: ollama (local) | groq (hosted) | gemini (hosted)
# Local dev (default): leave ollama — Ollama runs locally on your machine.
# Hosted (Vercel): set LLM_PROVIDER=groq + GROQ_API_KEY, or gemini + GEMINI_API_KEY.
# Tip: locally, if Ollama is off and a Groq/Gemini key is set, chat falls back
# to the hosted provider automatically.
LLM_PROVIDER=ollama

# Groq chat (OpenAI-compatible; hosts Qwen 3.8 27B).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT=120
GROQ_MAX_TOKENS=4096
# none = instruct mode (fast, direct). low/medium/high = thinking mode.
# Leave empty when GROQ_CHAT_MODEL points at a non-reasoning model.
GROQ_REASONING_EFFORT=none

# Gemini chat (optional) and embeddings.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Embeddings are independent of the chat provider and default to gemini when
# GEMINI_API_KEY is set, otherwise ollama. The current whole-resume chat path
# does not call embeddings, so this only matters if retrieval is added later.
# EMBED_PROVIDER=gemini

# --- Persistence (Vercel) ---
# Connect Upstash Redis from the Vercel Marketplace; it injects these
# automatically. Without them the backend falls back to /tmp (ephemeral).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
