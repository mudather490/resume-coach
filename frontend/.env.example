# Server-side target of the /api/backend proxy.
# Local dev: backend on port 8000.
# Vercel: leave unset — the service binding in vercel.json injects BACKEND_URL.
BACKEND_URL=http://localhost:8000

# Optional override to call a backend directly from the browser instead of the
# same-origin /api/backend proxy. Leave unset for the standard setup.
# NEXT_PUBLIC_API_BASE=http://localhost:8000
